# Project Settings
PROJECT_NAME=BATS - Binary Options AI Trading System
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change_me_in_production_secret_key_bats

# Database (PostgreSQL)
POSTGRES_USER=bats_user
POSTGRES_PASSWORD=bats_password
POSTGRES_DB=bats_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://bats_user:bats_password@postgres:5432/bats_db

# Cache / Real-time (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# API Settings
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
